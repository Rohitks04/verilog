#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5a876f9c68e0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5a876f9c6a70 .scope module, "tb_and_gate" "tb_and_gate" 3 3;
 .timescale -9 -12;
v0x5a876f9dbd30_0 .var "a", 0 0;
v0x5a876f9dbe00_0 .var "b", 0 0;
v0x5a876f9dbed0_0 .net "y", 0 0, L_0x5a876f9dbfd0;  1 drivers
S_0x5a876f98d500 .scope module, "uut" "and_gate" 3 8, 4 1 0, S_0x5a876f9c6a70;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y";
L_0x5a876f9dbfd0 .functor AND 1, v0x5a876f9dbd30_0, v0x5a876f9dbe00_0, C4<1>, C4<1>;
v0x5a876f98d730_0 .net "a", 0 0, v0x5a876f9dbd30_0;  1 drivers
v0x5a876f9dbb50_0 .net "b", 0 0, v0x5a876f9dbe00_0;  1 drivers
v0x5a876f9dbc10_0 .net "y", 0 0, L_0x5a876f9dbfd0;  alias, 1 drivers
    .scope S_0x5a876f9c6a70;
T_0 ;
    %vpi_call/w 3 15 "$dumpfile", "dump.vcd" {0 0 0};
    %vpi_call/w 3 16 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5a876f9c6a70 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x5a876f9c6a70;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a876f9dbd30_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a876f9dbe00_0, 0, 1;
    %delay 10000, 0;
    %load/vec4 v0x5a876f9dbed0_0;
    %pad/u 32;
    %cmpi/ne 0, 0, 32;
    %jmp/0xz  T_1.0, 6;
    %vpi_call/w 3 21 "$fatal", 32'sb00000000000000000000000000000001, "Failed: 0 & 0 should be 0" {0 0 0};
T_1.0 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a876f9dbd30_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a876f9dbe00_0, 0, 1;
    %delay 10000, 0;
    %load/vec4 v0x5a876f9dbed0_0;
    %pad/u 32;
    %cmpi/ne 0, 0, 32;
    %jmp/0xz  T_1.2, 6;
    %vpi_call/w 3 24 "$fatal", 32'sb00000000000000000000000000000001, "Failed: 0 & 1 should be 0" {0 0 0};
T_1.2 ;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a876f9dbd30_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a876f9dbe00_0, 0, 1;
    %delay 10000, 0;
    %load/vec4 v0x5a876f9dbed0_0;
    %pad/u 32;
    %cmpi/ne 0, 0, 32;
    %jmp/0xz  T_1.4, 6;
    %vpi_call/w 3 27 "$fatal", 32'sb00000000000000000000000000000001, "Failed: 1 & 0 should be 0" {0 0 0};
T_1.4 ;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a876f9dbd30_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a876f9dbe00_0, 0, 1;
    %delay 10000, 0;
    %load/vec4 v0x5a876f9dbed0_0;
    %pad/u 32;
    %cmpi/ne 1, 0, 32;
    %jmp/0xz  T_1.6, 6;
    %vpi_call/w 3 30 "$fatal", 32'sb00000000000000000000000000000001, "Failed: 1 & 1 should be 1" {0 0 0};
T_1.6 ;
    %vpi_call/w 3 32 "$display", "All AND gate tests passed." {0 0 0};
    %vpi_call/w 3 33 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "tb/tb_and_gate.v";
    "rtl/and_gate.v";
