#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x62480b400840 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x62480b4009d0 .scope module, "tb_decoder_2to4" "tb_decoder_2to4" 3 3;
 .timescale -9 -12;
v0x62480b413b30_0 .var "in", 1 0;
v0x62480b413bf0_0 .net "out", 3 0, v0x62480b4139f0_0;  1 drivers
S_0x62480b3c6500 .scope module, "dut" "decoder_2to4" 3 8, 4 1 0, S_0x62480b4009d0;
 .timescale 0 0;
    .port_info 0 /INPUT 2 "in";
    .port_info 1 /OUTPUT 4 "out";
v0x62480b3c6700_0 .net "in", 1 0, v0x62480b413b30_0;  1 drivers
v0x62480b4139f0_0 .var "out", 3 0;
E_0x62480b401210 .event anyedge, v0x62480b3c6700_0;
    .scope S_0x62480b3c6500;
T_0 ;
    %wait E_0x62480b401210;
    %load/vec4 v0x62480b3c6700_0;
    %dup/vec4;
    %pushi/vec4 0, 0, 2;
    %cmp/u;
    %jmp/1 T_0.0, 6;
    %dup/vec4;
    %pushi/vec4 1, 0, 2;
    %cmp/u;
    %jmp/1 T_0.1, 6;
    %dup/vec4;
    %pushi/vec4 2, 0, 2;
    %cmp/u;
    %jmp/1 T_0.2, 6;
    %dup/vec4;
    %pushi/vec4 3, 0, 2;
    %cmp/u;
    %jmp/1 T_0.3, 6;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x62480b4139f0_0, 0, 4;
    %jmp T_0.5;
T_0.0 ;
    %pushi/vec4 1, 0, 4;
    %store/vec4 v0x62480b4139f0_0, 0, 4;
    %jmp T_0.5;
T_0.1 ;
    %pushi/vec4 2, 0, 4;
    %store/vec4 v0x62480b4139f0_0, 0, 4;
    %jmp T_0.5;
T_0.2 ;
    %pushi/vec4 4, 0, 4;
    %store/vec4 v0x62480b4139f0_0, 0, 4;
    %jmp T_0.5;
T_0.3 ;
    %pushi/vec4 8, 0, 4;
    %store/vec4 v0x62480b4139f0_0, 0, 4;
    %jmp T_0.5;
T_0.5 ;
    %pop/vec4 1;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x62480b4009d0;
T_1 ;
    %vpi_call/w 3 14 "$dumpfile", "waves/dump.vcd" {0 0 0};
    %vpi_call/w 3 15 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x62480b4009d0 {0 0 0};
    %vpi_call/w 3 16 "$monitor", "Time=%0t | in=%b | out=%b", $time, v0x62480b413b30_0, v0x62480b413bf0_0 {0 0 0};
    %pushi/vec4 0, 0, 2;
    %store/vec4 v0x62480b413b30_0, 0, 2;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 2;
    %store/vec4 v0x62480b413b30_0, 0, 2;
    %delay 10000, 0;
    %pushi/vec4 2, 0, 2;
    %store/vec4 v0x62480b413b30_0, 0, 2;
    %delay 10000, 0;
    %pushi/vec4 3, 0, 2;
    %store/vec4 v0x62480b413b30_0, 0, 2;
    %delay 10000, 0;
    %vpi_call/w 3 26 "$finish" {0 0 0};
    %vpi_call/w 3 27 "$display", "test compeleted" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "tb/tb_decoder_2to4.v";
    "rtl/decoder_2to4.v";
