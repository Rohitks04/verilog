S_0x5a233a83a500 .scope module, "dut" "four_bit_half_adder" 3 12, 4 1 0, S_0x5a233a8743f0;
 .timescale 0 0;
    .port_info 0 /INPUT 4 "a";
    .port_info 1 /INPUT 4 "b";
    .port_info 2 /OUTPUT 4 "sum";
    .port_info 3 /OUTPUT 1 "carry";
