    %load/vec4 v0x5a233a88c2f0_0;
    %load/vec4 v0x5a233a88c3b0_0;
    %add;
    %pad/s 5;
    %store/vec4 v0x5a233a88c250_0, 0, 5;
    %delay 1000, 0;
    %load/vec4 v0x5a233a88c150_0;
    %load/vec4 v0x5a233a88c490_0;
    %concat/vec4; draw_concat_vec4
    %load/vec4 v0x5a233a88c250_0;
    %cmp/ne;
    %jmp/0xz  T_1.4, 6;
    %load/vec4 v0x5a233a88c150_0;
    %load/vec4 v0x5a233a88c490_0;
    %concat/vec4; draw_concat_vec4
    %vpi_call/w 3 32 "$display", "FAIL: a=%0d b=%0d expected=%0d got=%0d", v0x5a233a88bfa0_0, v0x5a233a88c080_0, v0x5a233a88c250_0, S<0,vec4,u5> {1 0 0};
    %vpi_call/w 3 34 "$finish" {0 0 0};
T_1.4 ;
