    %store/vec4 v0x5a233a88c2f0_0, 0, 32;
    %jmp T_1.0;
T_1.1 ;
    %vpi_call/w 3 39 "$display", "PASS: all 256 input combinations verified" {0 0 0};
    %vpi_call/w 3 40 "$finish" {0 0 0};
    %end;
    .thread T_1;
