L_0x5a233a88c550 .part L_0x5a233a88ca30, 4, 1;
L_0x5a233a88c640 .part L_0x5a233a88ca30, 0, 4;
L_0x5a233a88c780 .concat [ 4 1 0 0], v0x5a233a88bfa0_0, L_0x712905491018;
L_0x5a233a88c8c0 .concat [ 4 1 0 0], v0x5a233a88c080_0, L_0x712905491060;
L_0x5a233a88ca30 .arith/sum 5, L_0x5a233a88c780, L_0x5a233a88c8c0;
    .scope S_0x5a233a8743f0;
T_0 ;
    %vpi_call/w 3 20 "$dumpfile", "waves/dump.vcd" {0 0 0};
    %vpi_call/w 3 21 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5a233a8743f0 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x5a233a8743f0;
T_1 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5a233a88c2f0_0, 0, 32;
T_1.0 ;
    %load/vec4 v0x5a233a88c2f0_0;
