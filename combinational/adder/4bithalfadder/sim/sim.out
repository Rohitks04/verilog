    %jmp/0xz T_1.1, 5;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5a233a88c3b0_0, 0, 32;
T_1.2 ;
    %load/vec4 v0x5a233a88c3b0_0;
    %cmpi/s 16, 0, 32;
    %jmp/0xz T_1.3, 5;
    %load/vec4 v0x5a233a88c2f0_0;
    %pad/s 4;
    %store/vec4 v0x5a233a88bfa0_0, 0, 4;
