#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5f67d0369e70 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5f67d036a000 .scope module, "tb_half_adder" "tb_half_adder" 3 3;
 .timescale -9 -12;
v0x5f67d037fcb0_0 .var "a", 0 0;
v0x5f67d037fd70_0 .var "b", 0 0;
v0x5f67d037fe40_0 .net "carry", 0 0, L_0x5f67d0380170;  1 drivers
v0x5f67d037ff40_0 .net "sum", 0 0, L_0x5f67d0380010;  1 drivers
S_0x5f67d0330500 .scope module, "dut" "half_adder" 3 7, 4 1 0, S_0x5f67d036a000;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "sum";
    .port_info 3 /OUTPUT 1 "carry";
L_0x5f67d0380010 .functor XOR 1, v0x5f67d037fcb0_0, v0x5f67d037fd70_0, C4<0>, C4<0>;
L_0x5f67d0380170 .functor AND 1, v0x5f67d037fcb0_0, v0x5f67d037fd70_0, C4<1>, C4<1>;
v0x5f67d0330750_0 .net "a", 0 0, v0x5f67d037fcb0_0;  1 drivers
v0x5f67d037fa10_0 .net "b", 0 0, v0x5f67d037fd70_0;  1 drivers
v0x5f67d037fad0_0 .net "carry", 0 0, L_0x5f67d0380170;  alias, 1 drivers
v0x5f67d037fb70_0 .net "sum", 0 0, L_0x5f67d0380010;  alias, 1 drivers
    .scope S_0x5f67d036a000;
T_0 ;
    %vpi_call/w 3 15 "$dumpfile", "waves/dump.vcd" {0 0 0};
    %vpi_call/w 3 16 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5f67d036a000 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x5f67d036a000;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5f67d037fcb0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5f67d037fd70_0, 0, 1;
    %delay 10000, 0;
    %load/vec4 v0x5f67d037fe40_0;
    %load/vec4 v0x5f67d037ff40_0;
    %concat/vec4; draw_concat_vec4
    %cmpi/ne 0, 0, 2;
    %jmp/0xz  T_1.0, 6;
    %vpi_call/w 3 23 "$fatal", 32'sb00000000000000000000000000000001, "Failed: 0 + 0" {0 0 0};
T_1.0 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5f67d037fcb0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5f67d037fd70_0, 0, 1;
    %delay 10000, 0;
    %load/vec4 v0x5f67d037fe40_0;
    %load/vec4 v0x5f67d037ff40_0;
    %concat/vec4; draw_concat_vec4
    %cmpi/ne 1, 0, 2;
    %jmp/0xz  T_1.2, 6;
    %vpi_call/w 3 26 "$fatal", 32'sb00000000000000000000000000000001, "Failed: 0 + 1" {0 0 0};
T_1.2 ;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5f67d037fcb0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5f67d037fd70_0, 0, 1;
    %delay 10000, 0;
    %load/vec4 v0x5f67d037fe40_0;
    %load/vec4 v0x5f67d037ff40_0;
    %concat/vec4; draw_concat_vec4
    %cmpi/ne 1, 0, 2;
    %jmp/0xz  T_1.4, 6;
    %vpi_call/w 3 29 "$fatal", 32'sb00000000000000000000000000000001, "Failed: 1 + 0" {0 0 0};
T_1.4 ;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5f67d037fcb0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5f67d037fd70_0, 0, 1;
    %delay 10000, 0;
    %load/vec4 v0x5f67d037fe40_0;
    %load/vec4 v0x5f67d037ff40_0;
    %concat/vec4; draw_concat_vec4
    %cmpi/ne 2, 0, 2;
    %jmp/0xz  T_1.6, 6;
    %vpi_call/w 3 32 "$fatal", 32'sb00000000000000000000000000000001, "Failed: 1 + 1" {0 0 0};
T_1.6 ;
    %vpi_call/w 3 34 "$display", "All half-adder tests passed." {0 0 0};
    %vpi_call/w 3 35 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "tb/tb_half_adder.v";
    "rtl/half_adder.v";
