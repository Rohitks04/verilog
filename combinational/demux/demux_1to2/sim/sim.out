:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5aa6b83844d0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5aa6b8384660 .scope module, "tb_demux_1to2" "tb_demux_1to2" 3 3;
 .timescale -9 -12;
v0x5aa6b8398c30_0 .var "din", 0 0;
v0x5aa6b8398cf0_0 .var "sel", 0 0;
v0x5aa6b8398dc0_0 .net "y0", 0 0, v0x5aa6b83989f0_0;  1 drivers
v0x5aa6b8398ec0_0 .net "y1", 0 0, v0x5aa6b8398ac0_0;  1 drivers
S_0x5aa6b834a500 .scope module, "dut" "demux_1to2" 3 9, 4 1 0, S_0x5aa6b8384660;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "din";
    .port_info 1 /INPUT 1 "sel";
    .port_info 2 /OUTPUT 1 "y0";
    .port_info 3 /OUTPUT 1 "y1";
v0x5aa6b834a750_0 .net "din", 0 0, v0x5aa6b8398c30_0;  1 drivers
v0x5aa6b8398930_0 .net "sel", 0 0, v0x5aa6b8398cf0_0;  1 drivers
v0x5aa6b83989f0_0 .var "y0", 0 0;
v0x5aa6b8398ac0_0 .var "y1", 0 0;
E_0x5aa6b8384f50 .event anyedge, v0x5aa6b8398930_0, v0x5aa6b834a750_0;
    .scope S_0x5aa6b834a500;
T_0 ;
    %wait E_0x5aa6b8384f50;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5aa6b83989f0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5aa6b8398ac0_0, 0, 1;
    %load/vec4 v0x5aa6b8398930_0;
    %pad/u 32;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_0.0, 4;
    %load/vec4 v0x5aa6b834a750_0;
    %store/vec4 v0x5aa6b83989f0_0, 0, 1;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x5aa6b834a750_0;
    %store/vec4 v0x5aa6b8398ac0_0, 0, 1;
T_0.1 ;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x5aa6b8384660;
T_1 ;
    %vpi_call/w 3 17 "$dumpfile", "waves/dump.vcd" {0 0 0};
    %vpi_call/w 3 18 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5aa6b8384660 {0 0 0};
    %end;
    .thread T_1;
    .scope S_0x5aa6b8384660;
T_2 ;
    %vpi_call/w 3 22 "$monitor", "Time=%0t | din=%b sel=%b | y0=%b y1=%b", $time, v0x5aa6b8398c30_0, v0x5aa6b8398cf0_0, v0x5aa6b8398dc0_0, v0x5aa6b8398ec0_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5aa6b8398c30_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5aa6b8398cf0_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5aa6b8398c30_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5aa6b8398cf0_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5aa6b8398c30_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5aa6b8398cf0_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5aa6b8398c30_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5aa6b8398cf0_0, 0, 1;
    %delay 10000, 0;
    %vpi_call/w 3 30 "$finish" {0 0 0};
