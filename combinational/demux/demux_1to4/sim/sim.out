:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5e677a06bd60 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5e677a06bef0 .scope module, "tb_demux_1to4" "tb_demux_1to4" 3 3;
 .timescale -9 -12;
v0x5e677a081730_0 .var "din", 0 0;
v0x5e677a081800_0 .var "sel", 1 0;
v0x5e677a0818d0_0 .net "y", 3 0, v0x5e677a0815f0_0;  1 drivers
S_0x5e677a031500 .scope module, "uut" "demux_1to4" 3 9, 4 1 0, S_0x5e677a06bef0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "din";
    .port_info 1 /INPUT 2 "sel";
    .port_info 2 /OUTPUT 4 "y";
v0x5e677a031730_0 .net "din", 0 0, v0x5e677a081730_0;  1 drivers
v0x5e677a081510_0 .net "sel", 1 0, v0x5e677a081800_0;  1 drivers
v0x5e677a0815f0_0 .var "y", 3 0;
E_0x5e677a06c630 .event anyedge, v0x5e677a081510_0, v0x5e677a031730_0;
    .scope S_0x5e677a031500;
T_0 ;
    %wait E_0x5e677a06c630;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x5e677a0815f0_0, 0, 4;
    %load/vec4 v0x5e677a081510_0;
    %dup/vec4;
    %pushi/vec4 0, 0, 2;
    %cmp/u;
    %jmp/1 T_0.0, 6;
    %dup/vec4;
    %pushi/vec4 1, 0, 2;
    %cmp/u;
    %jmp/1 T_0.1, 6;
    %dup/vec4;
    %pushi/vec4 2, 0, 2;
    %cmp/u;
    %jmp/1 T_0.2, 6;
    %dup/vec4;
    %pushi/vec4 3, 0, 2;
    %cmp/u;
    %jmp/1 T_0.3, 6;
    %jmp T_0.4;
T_0.0 ;
    %load/vec4 v0x5e677a031730_0;
    %ix/load 4, 0, 0;
    %flag_set/imm 4, 0;
    %store/vec4 v0x5e677a0815f0_0, 4, 1;
    %jmp T_0.4;
T_0.1 ;
    %load/vec4 v0x5e677a031730_0;
    %ix/load 4, 1, 0;
    %flag_set/imm 4, 0;
    %store/vec4 v0x5e677a0815f0_0, 4, 1;
    %jmp T_0.4;
T_0.2 ;
    %load/vec4 v0x5e677a031730_0;
    %ix/load 4, 2, 0;
    %flag_set/imm 4, 0;
    %store/vec4 v0x5e677a0815f0_0, 4, 1;
    %jmp T_0.4;
T_0.3 ;
    %load/vec4 v0x5e677a031730_0;
    %ix/load 4, 3, 0;
    %flag_set/imm 4, 0;
    %store/vec4 v0x5e677a0815f0_0, 4, 1;
    %jmp T_0.4;
T_0.4 ;
    %pop/vec4 1;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x5e677a06bef0;
T_1 ;
    %vpi_call/w 3 16 "$dumpfile", "waves/dump.vcd" {0 0 0};
    %vpi_call/w 3 17 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5e677a06bef0 {0 0 0};
    %end;
    .thread T_1;
    .scope S_0x5e677a06bef0;
T_2 ;
    %vpi_call/w 3 21 "$monitor", "Time=%0t | din=%b sel=%b | y=%b", $time, v0x5e677a081730_0, v0x5e677a081800_0, v0x5e677a0818d0_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5e677a081730_0, 0, 1;
    %pushi/vec4 0, 0, 2;
    %store/vec4 v0x5e677a081800_0, 0, 2;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5e677a081730_0, 0, 1;
    %pushi/vec4 0, 0, 2;
    %store/vec4 v0x5e677a081800_0, 0, 2;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5e677a081730_0, 0, 1;
    %pushi/vec4 1, 0, 2;
    %store/vec4 v0x5e677a081800_0, 0, 2;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5e677a081730_0, 0, 1;
    %pushi/vec4 2, 0, 2;
    %store/vec4 v0x5e677a081800_0, 0, 2;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5e677a081730_0, 0, 1;
    %pushi/vec4 3, 0, 2;
    %store/vec4 v0x5e677a081800_0, 0, 2;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5e677a081730_0, 0, 1;
    %pushi/vec4 3, 0, 2;
    %store/vec4 v0x5e677a081800_0, 0, 2;
    %delay 10000, 0;
    %vpi_call/w 3 31 "$finish" {0 0 0};
    %end;
    .thread T_2;
