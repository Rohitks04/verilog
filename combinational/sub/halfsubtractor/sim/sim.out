#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x62fa6f035e10 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x62fa6f035fa0 .scope module, "tb_half_subtractor" "tb_half_subtractor" 3 3;
 .timescale -9 -12;
v0x62fa6f04fc70_0 .var "a", 0 0;
v0x62fa6f04fd30_0 .var "b", 0 0;
v0x62fa6f04fdd0_0 .net "borrow", 0 0, L_0x62fa6f050260;  1 drivers
v0x62fa6f04fed0_0 .net "diff", 0 0, L_0x62fa6f050090;  1 drivers
v0x62fa6f04ffa0_0 .var/i "errors", 31 0;
S_0x62fa6effc500 .scope task, "check_result" "check_result" 3 19, 3 19 0, S_0x62fa6f035fa0;
 .timescale -9 -12;
v0x62fa6effc6e0_0 .var "expected_borrow", 0 0;
v0x62fa6f04f4b0_0 .var "expected_diff", 0 0;
TD_tb_half_subtractor.check_result ;
    %delay 1000, 0;
    %vpi_call/w 3 24 "$display", "%0t\011%b\011%b\011%b\011%b", $time, v0x62fa6f04fc70_0, v0x62fa6f04fd30_0, v0x62fa6f04fed0_0, v0x62fa6f04fdd0_0 {0 0 0};
    %load/vec4 v0x62fa6f04fed0_0;
    %load/vec4 v0x62fa6f04f4b0_0;
    %cmp/ne;
    %jmp/1 T_0.2, 6;
    %flag_mov 8, 6;
    %load/vec4 v0x62fa6f04fdd0_0;
    %load/vec4 v0x62fa6effc6e0_0;
    %cmp/ne;
    %flag_or 6, 8;
T_0.2;
    %jmp/0xz  T_0.0, 6;
    %vpi_call/w 3 26 "$display", "ERROR: expected diff=%b borrow=%b", v0x62fa6f04f4b0_0, v0x62fa6effc6e0_0 {0 0 0};
    %load/vec4 v0x62fa6f04ffa0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x62fa6f04ffa0_0, 0, 32;
T_0.0 ;
    %delay 9000, 0;
    %end;
S_0x62fa6f04f570 .scope module, "dut" "half_subtractor" 3 12, 4 1 0, S_0x62fa6f035fa0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "diff";
    .port_info 3 /OUTPUT 1 "borrow";
L_0x62fa6f050090 .functor XOR 1, v0x62fa6f04fc70_0, v0x62fa6f04fd30_0, C4<0>, C4<0>;
L_0x62fa6f0501f0 .functor NOT 1, v0x62fa6f04fc70_0, C4<0>, C4<0>, C4<0>;
L_0x62fa6f050260 .functor AND 1, L_0x62fa6f0501f0, v0x62fa6f04fd30_0, C4<1>, C4<1>;
v0x62fa6f04f7e0_0 .net *"_ivl_2", 0 0, L_0x62fa6f0501f0;  1 drivers
v0x62fa6f04f8c0_0 .net "a", 0 0, v0x62fa6f04fc70_0;  1 drivers
v0x62fa6f04f980_0 .net "b", 0 0, v0x62fa6f04fd30_0;  1 drivers
v0x62fa6f04fa20_0 .net "borrow", 0 0, L_0x62fa6f050260;  alias, 1 drivers
v0x62fa6f04fae0_0 .net "diff", 0 0, L_0x62fa6f050090;  alias, 1 drivers
    .scope S_0x62fa6f035fa0;
T_1 ;
    %vpi_call/w 3 34 "$dumpfile", "waves/dump.vcd" {0 0 0};
    %vpi_call/w 3 35 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x62fa6f035fa0 {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x62fa6f04ffa0_0, 0, 32;
    %vpi_call/w 3 38 "$display", "Time\011a\011b\011diff\011borrow" {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x62fa6f04fc70_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x62fa6f04fd30_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x62fa6f04f4b0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x62fa6effc6e0_0, 0, 1;
    %fork TD_tb_half_subtractor.check_result, S_0x62fa6effc500;
    %join;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x62fa6f04fc70_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x62fa6f04fd30_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x62fa6f04f4b0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x62fa6effc6e0_0, 0, 1;
    %fork TD_tb_half_subtractor.check_result, S_0x62fa6effc500;
    %join;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x62fa6f04fc70_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x62fa6f04fd30_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x62fa6f04f4b0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x62fa6effc6e0_0, 0, 1;
    %fork TD_tb_half_subtractor.check_result, S_0x62fa6effc500;
    %join;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x62fa6f04fc70_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x62fa6f04fd30_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x62fa6f04f4b0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x62fa6effc6e0_0, 0, 1;
    %fork TD_tb_half_subtractor.check_result, S_0x62fa6effc500;
    %join;
    %load/vec4 v0x62fa6f04ffa0_0;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_1.0, 4;
    %vpi_call/w 3 46 "$display", "PASS: all half-subtractor test cases passed." {0 0 0};
    %jmp T_1.1;
T_1.0 ;
    %vpi_call/w 3 48 "$display", "FAIL: %0d half-subtractor test case(s) failed.", v0x62fa6f04ffa0_0 {0 0 0};
T_1.1 ;
    %vpi_call/w 3 50 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "tb/tb_half_subtractor.v";
    "rtl/half_subtractor.v";
