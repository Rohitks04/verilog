#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5fe75ba4eae0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5fe75ba4ec70 .scope module, "tb_binary_to_gray" "tb_binary_to_gray" 3 2;
 .timescale -9 -12;
v0x5fe75ba651a0_0 .var "binary", 3 0;
v0x5fe75ba65260_0 .var "expected", 3 0;
v0x5fe75ba65320_0 .net "gray", 3 0, L_0x5fe75ba65790;  1 drivers
v0x5fe75ba65420_0 .var/i "i", 31 0;
S_0x5fe75ba15500 .scope module, "dut" "binary_to_gray" 3 8, 4 1 0, S_0x5fe75ba4ec70;
 .timescale 0 0;
    .port_info 0 /INPUT 4 "binary";
    .port_info 1 /OUTPUT 4 "gray";
L_0x5fe75ba65790 .functor XOR 4, v0x5fe75ba651a0_0, L_0x5fe75ba65600, C4<0000>, C4<0000>;
v0x5fe75ba156e0_0 .net *"_ivl_0", 3 0, L_0x5fe75ba65600;  1 drivers
v0x5fe75ba64d90_0 .net *"_ivl_2", 2 0, L_0x5fe75ba654e0;  1 drivers
L_0x7cd4ff956018 .functor BUFT 1, C4<0>, C4<0>, C4<0>, C4<0>;
v0x5fe75ba64e70_0 .net *"_ivl_4", 0 0, L_0x7cd4ff956018;  1 drivers
v0x5fe75ba64f30_0 .net "binary", 3 0, v0x5fe75ba651a0_0;  1 drivers
v0x5fe75ba65010_0 .net "gray", 3 0, L_0x5fe75ba65790;  alias, 1 drivers
L_0x5fe75ba654e0 .part v0x5fe75ba651a0_0, 1, 3;
L_0x5fe75ba65600 .concat [ 3 1 0 0], L_0x5fe75ba654e0, L_0x7cd4ff956018;
    .scope S_0x5fe75ba4ec70;
T_0 ;
    %vpi_call/w 3 15 "$dumpfile", "dump.vcd" {0 0 0};
    %vpi_call/w 3 16 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5fe75ba4ec70 {0 0 0};
    %vpi_call/w 3 18 "$monitor", "time=%0t | binary=%b | gray =%b", $time, v0x5fe75ba651a0_0, v0x5fe75ba65320_0 {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5fe75ba65420_0, 0, 32;
T_0.0 ;
    %load/vec4 v0x5fe75ba65420_0;
    %cmpi/s 16, 0, 32;
    %jmp/0xz T_0.1, 5;
    %load/vec4 v0x5fe75ba65420_0;
    %pad/s 4;
    %store/vec4 v0x5fe75ba651a0_0, 0, 4;
    %delay 10000, 0;
    %load/vec4 v0x5fe75ba651a0_0;
    %load/vec4 v0x5fe75ba651a0_0;
    %ix/load 4, 1, 0;
    %flag_set/imm 4, 0;
    %shiftr 4;
    %xor;
    %store/vec4 v0x5fe75ba65260_0, 0, 4;
    %load/vec4 v0x5fe75ba65420_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5fe75ba65420_0, 0, 32;
    %jmp T_0.0;
T_0.1 ;
    %load/vec4 v0x5fe75ba65320_0;
    %load/vec4 v0x5fe75ba65260_0;
    %cmp/e;
    %jmp/0xz  T_0.2, 4;
    %vpi_call/w 3 25 "$display", "Test pass for binary=%b, expected gray=%b, got gray=%b", v0x5fe75ba651a0_0, v0x5fe75ba65260_0, v0x5fe75ba65320_0 {0 0 0};
    %jmp T_0.3;
T_0.2 ;
    %vpi_call/w 3 27 "$display", "Test failed for binary=%b, expected gray=%b, got gray=%b", v0x5fe75ba651a0_0, v0x5fe75ba65260_0, v0x5fe75ba65320_0 {0 0 0};
T_0.3 ;
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "tb_binary_to_gray.v";
    "binary_to_gray.v";
