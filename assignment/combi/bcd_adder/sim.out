S_0x5d23aebf7500 .scope module, "dut" "bcd_adder" 3 9, 4 1 0, S_0x5d23aec32c20;
 .timescale 0 0;
    .port_info 0 /INPUT 4 "a";
    .port_info 1 /INPUT 4 "b";
    .port_info 2 /INPUT 1 "cin";
