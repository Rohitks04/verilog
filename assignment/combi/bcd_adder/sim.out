    %jmp/0xz T_1.5, 5;
    %load/vec4 v0x5d23aec4b3b0_0;
    %pad/s 4;
    %store/vec4 v0x5d23aec4b030_0, 0, 4;
    %load/vec4 v0x5d23aec4b4a0_0;
    %pad/s 4;
    %store/vec4 v0x5d23aec4b110_0, 0, 4;
    %load/vec4 v0x5d23aec4b540_0;
    %pad/s 1;
    %store/vec4 v0x5d23aec4b1e0_0, 0, 1;
    %delay 10, 0;
