    %store/vec4 v0x5d23aec4ad80_0, 0, 4;
    %load/vec4 v0x5d23aec4aeb0_0;
    %parti/s 1, 4, 4;
    %store/vec4 v0x5d23aec4acc0_0, 0, 1;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x5d23aec32c20;
T_1 ;
