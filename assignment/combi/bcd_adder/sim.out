    .port_info 4 /OUTPUT 1 "cout";
v0x5d23aebf7710_0 .net "a", 3 0, v0x5d23aec4b030_0;  1 drivers
v0x5d23aec4ab10_0 .net "b", 3 0, v0x5d23aec4b110_0;  1 drivers
v0x5d23aec4abf0_0 .net "cin", 0 0, v0x5d23aec4b1e0_0;  1 drivers
v0x5d23aec4acc0_0 .var "cout", 0 0;
v0x5d23aec4ad80_0 .var "sum", 3 0;
v0x5d23aec4aeb0_0 .var "temp", 4 0;
E_0x5d23aec34010 .event anyedge, v0x5d23aebf7710_0, v0x5d23aec4ab10_0, v0x5d23aec4abf0_0, v0x5d23aec4aeb0_0;
    .scope S_0x5d23aebf7500;
T_0 ;
    %wait E_0x5d23aec34010;
    %pushi/vec4 0, 0, 1;
    %load/vec4 v0x5d23aebf7710_0;
