    %add;
    %load/vec4 v0x5d23aec4abf0_0;
    %pad/u 5;
    %add;
    %store/vec4 v0x5d23aec4aeb0_0, 0, 5;
    %load/vec4 v0x5d23aec4aeb0_0;
    %cmpi/u 9, 0, 5;
    %flag_or 5, 4; GT is !LE
    %flag_inv 5;
    %jmp/0xz  T_0.0, 5;
    %load/vec4 v0x5d23aec4aeb0_0;
    %addi 6, 0, 5;
    %store/vec4 v0x5d23aec4aeb0_0, 0, 5;
T_0.0 ;
    %load/vec4 v0x5d23aec4aeb0_0;
