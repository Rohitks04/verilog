#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x556f3dfe0bb0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x556f3dfe0d40 .scope module, "tb" "tb" 3 2;
 .timescale -12 -12;
v0x556f3dff5dc0_0 .var "a", 0 0;
v0x556f3dff5e90_0 .var "b", 0 0;
v0x556f3dff5f60_0 .net "y", 0 0, v0x556f3dff5ca0_0;  1 drivers
S_0x556f3dfa7500 .scope module, "dut" "procedural_always" 3 6, 4 1 0, S_0x556f3dfe0d40;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y";
v0x556f3dfa7730_0 .net "a", 0 0, v0x556f3dff5dc0_0;  1 drivers
v0x556f3dff5be0_0 .net "b", 0 0, v0x556f3dff5e90_0;  1 drivers
v0x556f3dff5ca0_0 .var "y", 0 0;
E_0x556f3dfe13f0 .event anyedge, v0x556f3dfa7730_0, v0x556f3dff5be0_0;
    .scope S_0x556f3dfa7500;
T_0 ;
    %wait E_0x556f3dfe13f0;
    %load/vec4 v0x556f3dfa7730_0;
    %load/vec4 v0x556f3dff5be0_0;
    %and;
    %store/vec4 v0x556f3dff5ca0_0, 0, 1;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x556f3dfe0d40;
T_1 ;
    %vpi_call/w 3 12 "$dumpfile", "dump.vcd" {0 0 0};
    %vpi_call/w 3 13 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x556f3dfe0d40 {0 0 0};
    %end;
    .thread T_1;
    .scope S_0x556f3dfe0d40;
T_2 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x556f3dff5dc0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x556f3dff5e90_0, 0, 1;
    %delay 10, 0;
    %load/vec4 v0x556f3dff5f60_0;
    %cmpi/ne 0, 0, 1;
    %jmp/0xz  T_2.0, 6;
    %vpi_call/w 3 18 "$fatal", 32'sb00000000000000000000000000000001, "Expected y=0 when a=0, b=0" {0 0 0};
T_2.0 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x556f3dff5dc0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x556f3dff5e90_0, 0, 1;
    %delay 10, 0;
    %load/vec4 v0x556f3dff5f60_0;
    %cmpi/ne 0, 0, 1;
    %jmp/0xz  T_2.2, 6;
    %vpi_call/w 3 21 "$fatal", 32'sb00000000000000000000000000000001, "Expected y=0 when a=0, b=1" {0 0 0};
T_2.2 ;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x556f3dff5dc0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x556f3dff5e90_0, 0, 1;
    %delay 10, 0;
    %load/vec4 v0x556f3dff5f60_0;
    %cmpi/ne 0, 0, 1;
    %jmp/0xz  T_2.4, 6;
    %vpi_call/w 3 24 "$fatal", 32'sb00000000000000000000000000000001, "Expected y=0 when a=1, b=0" {0 0 0};
T_2.4 ;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x556f3dff5dc0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x556f3dff5e90_0, 0, 1;
    %delay 10, 0;
    %load/vec4 v0x556f3dff5f60_0;
    %cmpi/ne 1, 0, 1;
    %jmp/0xz  T_2.6, 6;
    %vpi_call/w 3 27 "$fatal", 32'sb00000000000000000000000000000001, "Expected y=1 when a=1, b=1" {0 0 0};
T_2.6 ;
    %vpi_call/w 3 28 "$display", "PASS: procedural_always test completed" {0 0 0};
    %vpi_call/w 3 29 "$finish" {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "tb.v";
    "rtl.v";
