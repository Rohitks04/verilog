#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x597675ba7800 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x597675ba7990 .scope module, "tb" "tb" 3 3;
 .timescale -9 -12;
v0x597675bba2e0_0 .var "in", 0 0;
v0x597675bba380_0 .net "out", 0 0, L_0x597675bba450;  1 drivers
S_0x597675b6e500 .scope module, "dut" "hello_hardware" 3 7, 4 1 0, S_0x597675ba7990;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "in";
    .port_info 1 /OUTPUT 1 "out";
L_0x597675bba450 .functor BUFZ 1, v0x597675bba2e0_0, C4<0>, C4<0>, C4<0>;
v0x597675b6e6e0_0 .net "in", 0 0, v0x597675bba2e0_0;  1 drivers
v0x597675bba1c0_0 .net "out", 0 0, L_0x597675bba450;  alias, 1 drivers
    .scope S_0x597675ba7990;
T_0 ;
    %vpi_call/w 3 12 "$dumpfile", "dump.vcd" {0 0 0};
    %vpi_call/w 3 13 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x597675ba7990 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x597675ba7990;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x597675bba2e0_0, 0, 1;
    %delay 10000, 0;
    %load/vec4 v0x597675bba380_0;
    %cmpi/ne 0, 0, 1;
    %jmp/0xz  T_1.0, 6;
    %vpi_call/w 3 19 "$fatal", 32'sb00000000000000000000000000000001, "Expected out=0 when in=0" {0 0 0};
T_1.0 ;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x597675bba2e0_0, 0, 1;
    %delay 10000, 0;
    %load/vec4 v0x597675bba380_0;
    %cmpi/ne 1, 0, 1;
    %jmp/0xz  T_1.2, 6;
    %vpi_call/w 3 23 "$fatal", 32'sb00000000000000000000000000000001, "Expected out=1 when in=1" {0 0 0};
T_1.2 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x597675bba2e0_0, 0, 1;
    %delay 10000, 0;
    %load/vec4 v0x597675bba380_0;
    %cmpi/ne 0, 0, 1;
    %jmp/0xz  T_1.4, 6;
    %vpi_call/w 3 27 "$fatal", 32'sb00000000000000000000000000000001, "Expected out=0 when in=0" {0 0 0};
T_1.4 ;
    %vpi_call/w 3 29 "$display", "PASS: hello_hardware test completed" {0 0 0};
    %vpi_call/w 3 30 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "tb.v";
    "rtl.v";
