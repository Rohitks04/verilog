#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5e3036561840 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5e30365619d0 .scope module, "tb" "tb" 3 2;
 .timescale -12 -12;
v0x5e3036576880_0 .var "a", 0 0;
v0x5e3036576950_0 .var "b", 0 0;
v0x5e3036576a20_0 .net "y", 0 0, L_0x5e3036576b20;  1 drivers
S_0x5e3036528500 .scope module, "dut" "continuous_assign" 3 6, 4 1 0, S_0x5e30365619d0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y";
L_0x5e3036576b20 .functor AND 1, v0x5e3036576880_0, v0x5e3036576950_0, C4<1>, C4<1>;
v0x5e3036528730_0 .net "a", 0 0, v0x5e3036576880_0;  1 drivers
v0x5e30365766a0_0 .net "b", 0 0, v0x5e3036576950_0;  1 drivers
v0x5e3036576760_0 .net "y", 0 0, L_0x5e3036576b20;  alias, 1 drivers
    .scope S_0x5e30365619d0;
T_0 ;
    %vpi_call/w 3 12 "$dumpfile", "dump.vcd" {0 0 0};
    %vpi_call/w 3 13 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5e30365619d0 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x5e30365619d0;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5e3036576880_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5e3036576950_0, 0, 1;
    %delay 10, 0;
    %load/vec4 v0x5e3036576a20_0;
    %cmpi/ne 0, 0, 1;
    %jmp/0xz  T_1.0, 6;
    %vpi_call/w 3 18 "$fatal", 32'sb00000000000000000000000000000001, "Expected y=0 when a=0, b=0" {0 0 0};
T_1.0 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5e3036576880_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5e3036576950_0, 0, 1;
    %delay 10, 0;
    %load/vec4 v0x5e3036576a20_0;
    %cmpi/ne 0, 0, 1;
    %jmp/0xz  T_1.2, 6;
    %vpi_call/w 3 21 "$fatal", 32'sb00000000000000000000000000000001, "Expected y=0 when a=0, b=1" {0 0 0};
T_1.2 ;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5e3036576880_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5e3036576950_0, 0, 1;
    %delay 10, 0;
    %load/vec4 v0x5e3036576a20_0;
    %cmpi/ne 0, 0, 1;
    %jmp/0xz  T_1.4, 6;
    %vpi_call/w 3 24 "$fatal", 32'sb00000000000000000000000000000001, "Expected y=0 when a=1, b=0" {0 0 0};
T_1.4 ;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5e3036576880_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5e3036576950_0, 0, 1;
    %delay 10, 0;
    %load/vec4 v0x5e3036576a20_0;
    %cmpi/ne 1, 0, 1;
    %jmp/0xz  T_1.6, 6;
    %vpi_call/w 3 27 "$fatal", 32'sb00000000000000000000000000000001, "Expected y=1 when a=1, b=1" {0 0 0};
T_1.6 ;
    %vpi_call/w 3 28 "$display", "PASS: continuous_assign test completed" {0 0 0};
    %vpi_call/w 3 29 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "tb.v";
    "rtl.v";
