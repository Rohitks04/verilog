:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5613367308d0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x561336730a60 .scope module, "tb_not_gate" "tb_not_gate" 3 3;
 .timescale -9 -12;
v0x561336742290_0 .var "a", 0 0;
v0x561336742330_0 .net "y", 0 0, L_0x561336742400;  1 drivers
S_0x5613366f7500 .scope module, "dut" "not_gate" 3 8, 4 1 0, S_0x561336730a60;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /OUTPUT 1 "y";
L_0x561336742400 .functor NOT 1, v0x561336742290_0, C4<0>, C4<0>, C4<0>;
v0x5613366f76e0_0 .net "a", 0 0, v0x561336742290_0;  1 drivers
v0x561336742170_0 .net "y", 0 0, L_0x561336742400;  alias, 1 drivers
    .scope S_0x561336730a60;
T_0 ;
    %vpi_call/w 3 11 "$dumpfile", "waves/dump.vcd" {0 0 0};
    %vpi_call/w 3 12 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x561336730a60 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x561336730a60;
T_1 ;
    %vpi_call/w 3 16 "$monitor", "time=%0t a=%b y=%b", $time, v0x561336742290_0, v0x561336742330_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x561336742290_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x561336742290_0, 0, 1;
    %delay 10000, 0;
    %vpi_call/w 3 23 "$finish" {0 0 0};
    %end;
    .thread T_1;
