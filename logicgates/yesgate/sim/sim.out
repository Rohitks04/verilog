#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5a2346cf35d0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5a2346cf3760 .scope module, "tb_yes_gate" "tb_yes_gate" 3 3;
 .timescale -9 -12;
v0x5a2346d3e2f0_0 .var "a", 0 0;
v0x5a2346d3e390_0 .net "y", 0 0, L_0x5a2346d3e460;  1 drivers
S_0x5a2346d2c820 .scope module, "dut" "yes_gate" 3 8, 4 1 0, S_0x5a2346cf3760;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /OUTPUT 1 "y";
L_0x5a2346d3e460 .functor BUFZ 1, v0x5a2346d3e2f0_0, C4<0>, C4<0>, C4<0>;
v0x5a2346d2ca00_0 .net "a", 0 0, v0x5a2346d3e2f0_0;  1 drivers
v0x5a2346d3e1d0_0 .net "y", 0 0, L_0x5a2346d3e460;  alias, 1 drivers
    .scope S_0x5a2346cf3760;
T_0 ;
    %vpi_call/w 3 14 "$dumpfile", "waves/dump.vcd" {0 0 0};
    %vpi_call/w 3 15 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5a2346cf3760 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x5a2346cf3760;
T_1 ;
    %vpi_call/w 3 19 "$monitor", "Time=%0t | a=%b | y=%b", $time, v0x5a2346d3e2f0_0, v0x5a2346d3e390_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a2346d3e2f0_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a2346d3e2f0_0, 0, 1;
    %delay 10000, 0;
    %vpi_call/w 3 24 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "tb/tb_yes_gate.v";
    "rtl/yes_gate.v";
