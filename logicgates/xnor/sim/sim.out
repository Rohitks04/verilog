#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5d2919c135a0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5d2919c13730 .scope module, "tb_xnor_gate" "tb_xnor_gate" 3 3;
 .timescale -9 -12;
v0x5d2919c608a0_0 .var "a", 0 0;
v0x5d2919c60970_0 .var "b", 0 0;
v0x5d2919c60a40_0 .net "y", 0 0, L_0x5d2919c60c80;  1 drivers
S_0x5d2919c4c880 .scope module, "dut" "xnor_gate" 3 9, 4 1 0, S_0x5d2919c13730;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y";
L_0x5d2919c60b40 .functor XOR 1, v0x5d2919c608a0_0, v0x5d2919c60970_0, C4<0>, C4<0>;
L_0x5d2919c60c80 .functor NOT 1, L_0x5d2919c60b40, C4<0>, C4<0>, C4<0>;
v0x5d2919c4cab0_0 .net *"_ivl_0", 0 0, L_0x5d2919c60b40;  1 drivers
v0x5d2919c60600_0 .net "a", 0 0, v0x5d2919c608a0_0;  1 drivers
v0x5d2919c606c0_0 .net "b", 0 0, v0x5d2919c60970_0;  1 drivers
v0x5d2919c60760_0 .net "y", 0 0, L_0x5d2919c60c80;  alias, 1 drivers
    .scope S_0x5d2919c13730;
T_0 ;
    %vpi_call/w 3 16 "$dumpfile", "waves/dump.vcd" {0 0 0};
    %vpi_call/w 3 17 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5d2919c13730 {0 0 0};
    %vpi_call/w 3 18 "$monitor", "At time %t: a=%b, b=%b, y=%b", $time, v0x5d2919c608a0_0, v0x5d2919c60970_0, v0x5d2919c60a40_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5d2919c608a0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5d2919c60970_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5d2919c608a0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5d2919c60970_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5d2919c608a0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5d2919c60970_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5d2919c608a0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5d2919c60970_0, 0, 1;
    %delay 10000, 0;
    %vpi_call/w 3 25 "$display", "Test completed" {0 0 0};
    %vpi_call/w 3 26 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "tb/tb_xnor_gate.v";
    "rtl/xnor_gate.v";
