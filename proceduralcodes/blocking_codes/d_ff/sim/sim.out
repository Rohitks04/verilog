#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x632e11d51ca0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x632e11d51e30 .scope module, "tb_d_ff_blocking" "tb_d_ff_blocking" 3 3;
 .timescale -9 -12;
v0x632e11d66330_0 .var "clk", 0 0;
v0x632e11d66400_0 .var "d", 0 0;
v0x632e11d664d0_0 .net "q", 0 0, v0x632e11d66210_0;  1 drivers
S_0x632e11d18500 .scope module, "uut" "d_ff_blocking" 3 8, 4 1 0, S_0x632e11d51e30;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "d";
    .port_info 2 /OUTPUT 1 "q";
v0x632e11d18730_0 .net "clk", 0 0, v0x632e11d66330_0;  1 drivers
v0x632e11d66150_0 .net "d", 0 0, v0x632e11d66400_0;  1 drivers
v0x632e11d66210_0 .var "q", 0 0;
E_0x632e11d52430 .event posedge, v0x632e11d18730_0;
    .scope S_0x632e11d18500;
T_0 ;
    %wait E_0x632e11d52430;
    %load/vec4 v0x632e11d66150_0;
    %store/vec4 v0x632e11d66210_0, 0, 1;
    %jmp T_0;
    .thread T_0;
    .scope S_0x632e11d51e30;
T_1 ;
    %delay 5000, 0;
    %load/vec4 v0x632e11d66330_0;
    %inv;
    %store/vec4 v0x632e11d66330_0, 0, 1;
    %jmp T_1;
    .thread T_1;
    .scope S_0x632e11d51e30;
T_2 ;
    %vpi_call/w 3 17 "$dumpfile", "waves/dump.vcd" {0 0 0};
    %vpi_call/w 3 18 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x632e11d51e30 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x632e11d66330_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x632e11d66400_0, 0, 1;
    %delay 2000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x632e11d66400_0, 0, 1;
    %delay 6000, 0;
    %load/vec4 v0x632e11d664d0_0;
    %cmpi/ne 1, 0, 1;
    %jmp/0xz  T_2.0, 6;
    %vpi_call/w 3 25 "$fatal", 32'sb00000000000000000000000000000001, "Expected q=1 after sampling d=1" {0 0 0};
T_2.0 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x632e11d66400_0, 0, 1;
    %delay 10000, 0;
    %load/vec4 v0x632e11d664d0_0;
    %cmpi/ne 0, 0, 1;
    %jmp/0xz  T_2.2, 6;
    %vpi_call/w 3 29 "$fatal", 32'sb00000000000000000000000000000001, "Expected q=0 after sampling d=0" {0 0 0};
T_2.2 ;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x632e11d66400_0, 0, 1;
    %delay 10000, 0;
    %load/vec4 v0x632e11d664d0_0;
    %cmpi/ne 1, 0, 1;
    %jmp/0xz  T_2.4, 6;
    %vpi_call/w 3 33 "$fatal", 32'sb00000000000000000000000000000001, "Expected q=1 after sampling d=1" {0 0 0};
T_2.4 ;
    %vpi_call/w 3 35 "$display", "d_ff_blocking test passed" {0 0 0};
    %vpi_call/w 3 36 "$finish" {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "tb/tb_d_ff_blocking.v";
    "rtl/d_ff_blocking.v";
