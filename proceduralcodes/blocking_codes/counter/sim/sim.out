#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5fa82debd340 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5fa82decd420 .scope module, "tb_counter_blocking" "tb_counter_blocking" 3 3;
 .timescale -9 -12;
v0x5fa82dee42d0_0 .var "clk", 0 0;
v0x5fa82dee43a0_0 .net "count", 3 0, v0x5fa82dee40d0_0;  1 drivers
v0x5fa82dee4470_0 .var/i "cycle", 31 0;
v0x5fa82dee4540_0 .var/i "expected", 31 0;
v0x5fa82dee4620_0 .var "reset", 0 0;
E_0x5fa82decdf80 .event negedge, v0x5fa82debbb90_0;
S_0x5fa82decd5b0 .scope module, "dut" "counter_blocking" 3 8, 4 1 0, S_0x5fa82decd420;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "reset";
    .port_info 2 /OUTPUT 4 "count";
P_0x5fa82decd790 .param/l "WIDTH" 0 4 2, +C4<00000000000000000000000000000100>;
v0x5fa82debbb90_0 .net "clk", 0 0, v0x5fa82dee42d0_0;  1 drivers
v0x5fa82dee40d0_0 .var "count", 3 0;
v0x5fa82dee41b0_0 .net "reset", 0 0, v0x5fa82dee4620_0;  1 drivers
E_0x5fa82decf390 .event posedge, v0x5fa82debbb90_0;
    .scope S_0x5fa82decd5b0;
T_0 ;
    %wait E_0x5fa82decf390;
    %load/vec4 v0x5fa82dee41b0_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x5fa82dee40d0_0, 0, 4;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x5fa82dee40d0_0;
    %addi 1, 0, 4;
    %store/vec4 v0x5fa82dee40d0_0, 0, 4;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x5fa82decd420;
T_1 ;
    %vpi_call/w 3 15 "$dumpfile", "waves/dump.vcd" {0 0 0};
    %vpi_call/w 3 16 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5fa82decd420 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5fa82dee42d0_0, 0, 1;
T_1.0 ;
    %delay 5000, 0;
    %load/vec4 v0x5fa82dee42d0_0;
    %inv;
    %store/vec4 v0x5fa82dee42d0_0, 0, 1;
    %jmp T_1.0;
    %end;
    .thread T_1;
    .scope S_0x5fa82decd420;
T_2 ;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5fa82dee4620_0, 0, 1;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5fa82dee4540_0, 0, 32;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5fa82dee4470_0, 0, 32;
    %wait E_0x5fa82decf390;
    %delay 1000, 0;
    %load/vec4 v0x5fa82dee43a0_0;
    %cmpi/ne 0, 0, 4;
    %jmp/0xz  T_2.0, 6;
    %vpi_call/w 3 33 "$fatal", 32'sb00000000000000000000000000000001, "Reset failed: expected 0, got %0d", v0x5fa82dee43a0_0 {0 0 0};
T_2.0 ;
    %wait E_0x5fa82decdf80;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5fa82dee4620_0, 0, 1;
    %pushi/vec4 20, 0, 32;
T_2.2 %dup/vec4;
    %pushi/vec4 0, 0, 32;
    %cmp/s;
    %jmp/1xz T_2.3, 5;
    %jmp/1 T_2.3, 4;
    %pushi/vec4 1, 0, 32;
    %sub;
    %wait E_0x5fa82decf390;
    %load/vec4 v0x5fa82dee4540_0;
    %addi 1, 0, 32;
    %pushi/vec4 16, 0, 32;
    %mod/s;
    %store/vec4 v0x5fa82dee4540_0, 0, 32;
    %delay 1000, 0;
    %load/vec4 v0x5fa82dee4470_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5fa82dee4470_0, 0, 32;
    %load/vec4 v0x5fa82dee43a0_0;
    %load/vec4 v0x5fa82dee4540_0;
    %parti/s 4, 0, 2;
    %cmp/ne;
    %jmp/0xz  T_2.4, 6;
    %vpi_call/w 3 44 "$fatal", 32'sb00000000000000000000000000000001, "Cycle %0d: expected %0d, got %0d", v0x5fa82dee4470_0, v0x5fa82dee4540_0, v0x5fa82dee43a0_0 {0 0 0};
T_2.4 ;
    %jmp T_2.2;
T_2.3 ;
    %pop/vec4 1;
    %vpi_call/w 3 47 "$display", "PASS: counter increment and rollover checks passed" {0 0 0};
    %vpi_call/w 3 48 "$finish" {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "tb/tb_counter_blocking.v";
    "rtl/counter_blocking.v";
