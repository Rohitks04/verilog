 .timescale 0 0;
S_0x613d0653ef70 .scope module, "tb_mux_2in1" "tb_mux_2in1" 3 3;
 .timescale -9 -12;
v0x613d06552d60_0 .var "a", 0 0;
v0x613d06552e20_0 .var "b", 0 0;
v0x613d06552ef0_0 .var/i "i", 31 0;
v0x613d06552fc0_0 .var "sel", 0 0;
v0x613d06553090_0 .net "y", 0 0, v0x613d06552bf0_0;  1 drivers
S_0x613d0653f100 .scope module, "dut" "mux_2in1" 3 11, 4 1 0, S_0x613d0653ef70;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /INPUT 1 "sel";
    .port_info 3 /OUTPUT 1 "y";
v0x613d0653f350_0 .net "a", 0 0, v0x613d06552d60_0;  1 drivers
v0x613d06552a60_0 .net "b", 0 0, v0x613d06552e20_0;  1 drivers
v0x613d06552b20_0 .net "sel", 0 0, v0x613d06552fc0_0;  1 drivers
v0x613d06552bf0_0 .var "y", 0 0;
E_0x613d0653f810 .event anyedge, v0x613d06552b20_0, v0x613d06552a60_0, v0x613d0653f350_0;
    .scope S_0x613d0653f100;
T_0 ;
    %wait E_0x613d0653f810;
    %load/vec4 v0x613d06552b20_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %load/vec4 v0x613d06552a60_0;
    %store/vec4 v0x613d06552bf0_0, 0, 1;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x613d0653f350_0;
    %store/vec4 v0x613d06552bf0_0, 0, 1;
T_0.1 ;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x613d0653ef70;
T_1 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x613d06552ef0_0, 0, 32;
T_1.0 ;
    %load/vec4 v0x613d06552ef0_0;
    %cmpi/s 8, 0, 32;
    %jmp/0xz T_1.1, 5;
    %load/vec4 v0x613d06552ef0_0;
    %parti/s 3, 0, 2;
    %split/vec4 1;
    %store/vec4 v0x613d06552d60_0, 0, 1;
    %split/vec4 1;
    %store/vec4 v0x613d06552e20_0, 0, 1;
    %store/vec4 v0x613d06552fc0_0, 0, 1;
    %delay 10000, 0;
    %load/vec4 v0x613d06553090_0;
    %load/vec4 v0x613d06552fc0_0;
    %flag_set/vec4 8;
    %jmp/0 T_1.4, 8;
    %load/vec4 v0x613d06552e20_0;
    %jmp/1 T_1.5, 8;
T_1.4 ; End of true expr.
    %load/vec4 v0x613d06552d60_0;
    %jmp/0 T_1.5, 8;
 ; End of false expr.
    %blend;
T_1.5;
    %cmp/ne;
    %jmp/0xz  T_1.2, 6;
    %vpi_call/w 3 23 "$display", "FAIL: a=%b b=%b sel=%b y=%b", v0x613d06552d60_0, v0x613d06552e20_0, v0x613d06552fc0_0, v0x613d06553090_0 {0 0 0};
    %vpi_call/w 3 24 "$finish" {0 0 0};
T_1.2 ;
    %load/vec4 v0x613d06552ef0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x613d06552ef0_0, 0, 32;
    %jmp T_1.0;
T_1.1 ;
    %vpi_call/w 3 28 "$display", "PASS: all mux_2in1 input combinations verified" {0 0 0};
    %vpi_call/w 3 29 "$finish" {0 0 0};
    %end;
    .thread T_1;
