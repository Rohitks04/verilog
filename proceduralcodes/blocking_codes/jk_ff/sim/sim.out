:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x63e74bce5bd0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x63e74bce5d60 .scope module, "tb_jk_ff_block" "tb_jk_ff_block" 3 3;
 .timescale -9 -12;
v0x63e74bcfe6e0_0 .var "clk", 0 0;
v0x63e74bcfe7a0_0 .var "j", 0 0;
v0x63e74bcfe870_0 .var "k", 0 0;
v0x63e74bcfe970_0 .net "q", 0 0, v0x63e74bcfe470_0;  1 drivers
v0x63e74bcfea40_0 .net "qbar", 0 0, v0x63e74bcfe530_0;  1 drivers
S_0x63e74bcab500 .scope task, "apply_inputs" "apply_inputs" 3 20, 3 20 0, S_0x63e74bce5d60;
 .timescale -9 -12;
v0x63e74bcab700_0 .var "expected_q", 0 0;
v0x63e74bcfde40_0 .var "j_value", 0 0;
v0x63e74bcfdf00_0 .var "k_value", 0 0;
E_0x63e74bce64a0 .event posedge, v0x63e74bcfe220_0;
E_0x63e74bce6810 .event negedge, v0x63e74bcfe220_0;
TD_tb_jk_ff_block.apply_inputs ;
    %wait E_0x63e74bce6810;
    %load/vec4 v0x63e74bcfde40_0;
    %store/vec4 v0x63e74bcfe7a0_0, 0, 1;
    %load/vec4 v0x63e74bcfdf00_0;
    %store/vec4 v0x63e74bcfe870_0, 0, 1;
    %wait E_0x63e74bce64a0;
    %delay 1000, 0;
    %load/vec4 v0x63e74bcfe970_0;
    %load/vec4 v0x63e74bcab700_0;
    %cmp/ne;
    %jmp/1 T_0.2, 6;
    %flag_mov 8, 6;
    %load/vec4 v0x63e74bcfea40_0;
    %load/vec4 v0x63e74bcab700_0;
    %inv;
    %cmp/ne;
    %flag_or 6, 8;
T_0.2;
    %jmp/0xz  T_0.0, 6;
    %load/vec4 v0x63e74bcab700_0;
    %inv;
    %vpi_call/w 3 31 "$display", "FAIL: j=%b k=%b expected q=%b qbar=%b, got q=%b qbar=%b", v0x63e74bcfde40_0, v0x63e74bcfdf00_0, v0x63e74bcab700_0, S<0,vec4,u1>, v0x63e74bcfe970_0, v0x63e74bcfea40_0 {1 0 0};
    %vpi_call/w 3 33 "$finish" {0 0 0};
T_0.0 ;
    %end;
S_0x63e74bcfdfa0 .scope module, "dut" "jk_ff_block" 3 10, 4 1 0, S_0x63e74bce5d60;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "j";
    .port_info 1 /INPUT 1 "k";
    .port_info 2 /INPUT 1 "clk";
    .port_info 3 /OUTPUT 1 "q";
    .port_info 4 /OUTPUT 1 "qbar";
v0x63e74bcfe220_0 .net "clk", 0 0, v0x63e74bcfe6e0_0;  1 drivers
v0x63e74bcfe2e0_0 .net "j", 0 0, v0x63e74bcfe7a0_0;  1 drivers
v0x63e74bcfe3a0_0 .net "k", 0 0, v0x63e74bcfe870_0;  1 drivers
v0x63e74bcfe470_0 .var "q", 0 0;
v0x63e74bcfe530_0 .var "qbar", 0 0;
    .scope S_0x63e74bcfdfa0;
T_1 ;
    %wait E_0x63e74bce64a0;
    %load/vec4 v0x63e74bcfe2e0_0;
    %load/vec4 v0x63e74bcfe3a0_0;
    %concat/vec4; draw_concat_vec4
    %dup/vec4;
    %pushi/vec4 0, 0, 2;
    %cmp/u;
    %jmp/1 T_1.0, 6;
    %dup/vec4;
    %pushi/vec4 1, 0, 2;
    %cmp/u;
    %jmp/1 T_1.1, 6;
    %dup/vec4;
    %pushi/vec4 2, 0, 2;
    %cmp/u;
    %jmp/1 T_1.2, 6;
    %dup/vec4;
    %pushi/vec4 3, 0, 2;
    %cmp/u;
    %jmp/1 T_1.3, 6;
    %jmp T_1.4;
T_1.0 ;
    %load/vec4 v0x63e74bcfe470_0;
    %store/vec4 v0x63e74bcfe470_0, 0, 1;
    %jmp T_1.4;
T_1.1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x63e74bcfe470_0, 0, 1;
    %jmp T_1.4;
T_1.2 ;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x63e74bcfe470_0, 0, 1;
    %jmp T_1.4;
T_1.3 ;
    %load/vec4 v0x63e74bcfe470_0;
    %inv;
    %store/vec4 v0x63e74bcfe470_0, 0, 1;
    %jmp T_1.4;
T_1.4 ;
    %pop/vec4 1;
    %jmp T_1;
    .thread T_1;
    .scope S_0x63e74bce5d60;
T_2 ;
    %delay 5000, 0;
    %load/vec4 v0x63e74bcfe6e0_0;
    %inv;
    %store/vec4 v0x63e74bcfe6e0_0, 0, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_0x63e74bce5d60;
T_3 ;
    %vpi_call/w 3 39 "$dumpfile", "waves/dump.vcd" {0 0 0};
    %vpi_call/w 3 40 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x63e74bce5d60 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x63e74bcfe6e0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x63e74bcfe7a0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x63e74bcfe870_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x63e74bcfde40_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x63e74bcfdf00_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x63e74bcab700_0, 0, 1;
    %fork TD_tb_jk_ff_block.apply_inputs, S_0x63e74bcab500;
    %join;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x63e74bcfde40_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x63e74bcfdf00_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x63e74bcab700_0, 0, 1;
    %fork TD_tb_jk_ff_block.apply_inputs, S_0x63e74bcab500;
    %join;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x63e74bcfde40_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x63e74bcfdf00_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x63e74bcab700_0, 0, 1;
    %fork TD_tb_jk_ff_block.apply_inputs, S_0x63e74bcab500;
    %join;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x63e74bcfde40_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x63e74bcfdf00_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x63e74bcab700_0, 0, 1;
    %fork TD_tb_jk_ff_block.apply_inputs, S_0x63e74bcab500;
    %join;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x63e74bcfde40_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x63e74bcfdf00_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x63e74bcab700_0, 0, 1;
    %fork TD_tb_jk_ff_block.apply_inputs, S_0x63e74bcab500;
    %join;
    %vpi_call/w 3 52 "$display", "PASS: all JK flip-flop tests passed" {0 0 0};
    %vpi_call/w 3 53 "$finish" {0 0 0};
    %end;
    .thread T_3;
